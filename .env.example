# ===========================================
# DemoSpring Environment Configuration
# ===========================================

# ============================================
# SLACK CONFIGURATION
# ============================================

# Bot User OAuth Token (starts with xoxb-)
# Get from: https://api.slack.com/apps → Your App → OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# Enable/disable Slack integration
SLACK_ENABLED=true

# Optional: Default channel
SLACK_CHANNEL_ID=
SLACK_CHANNEL_NAME=

# ============================================
# REDIS
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# JWT & SECURITY
# ============================================
JWT_SECRET=your-random-jwt-secret-here-change-this
REDIRECT_URI=http://localhost:8080

# ============================================
# DATABASE
# ============================================
# Default: H2 in-memory (no persistence)
# For persistence: Use PostgreSQL profile

# PostgreSQL Configuration (when using -Dspring-boot.run.profiles=postgres)
# Default values match docker-compose.yml
DATABASE_URL=jdbc:postgresql://localhost:5432/demospring
DB_USERNAME=demospring
DB_PASSWORD=demospring123

# Or leave empty to use H2 in-memory (data lost on restart)
# DATABASE_URL=
# DB_USERNAME=
# DB_PASSWORD=

# ============================================
# SALESFORCE (if needed)
# ============================================
SF_LOGIN_URL=
SF_CLIENT_ID=
SF_USERNAME=
SF_SESSION_TIMEOUT=
SF_CONNECTOR_NAME=

# ============================================
# NETATMO (if needed)
# ============================================
NETATMO_CLIENT_ID=
NETATMO_CLIENT_SECRET=
